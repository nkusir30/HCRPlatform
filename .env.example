# ============================================================
# HCR DSP SCHEDULING & PAYROLL PLATFORM — Environment
# Copy this file to .env and fill in values
# ============================================================

# --- Database (PostgreSQL) ---
# docker compose sets this automatically via docker-compose.yaml
DATABASE_URL=postgresql://hcr:hcrpassword@localhost:5432/hcr?schema=public

# --- Redis (BullMQ / caching) ---
REDIS_URL=redis://localhost:6379

# --- JWT auth ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# --- Application ---
NODE_ENV=development
APP_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Third-party secrets (leave empty for local dev) ---
STRIPE_SECRET_KEY=
PLAID_SECRET=
DOCUSIGN_INTEGRATION_KEY=
GOODTIME_API_KEY=
BARLEY_API_KEY=

# --- mem0 long-term memory (self-hosted server in /mem0/server) ---
# Leave MEM0_BASE_URL empty to disable; /api/memory/* then returns 503.
MEM0_BASE_URL=http://localhost:8888
MEM0_API_KEY=
MEM0_TIMEOUT_MS=15000

# --- AI ---
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

# --- Demo mode ---
# Set to true to enable demo seed data on first migration
DEMO_MODE=true
