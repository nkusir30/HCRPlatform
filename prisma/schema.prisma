}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// SECRET / SENSITIVE CONFIG (database-level)
// ---------------------------------------------------------------------------
model Secret {
  id        String   @id @default(cuid())
  orgId     String
  tenant    String
  key       String // encrypted at rest
  value     String // encrypted at rest
  kind      String // "API_KEY", "PAYMENT_ACCT", "OAUTH_CLIENT", "MFA_SECRET"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, tenant, key])
  @@index([orgId])
}

